# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Domain Name API — OT&E only; keep real credentials in local .env.local / Vercel Environment Variables.
# Never use NEXT_PUBLIC_ prefixes for registrar credentials.
DOMAIN_PROVIDER_MODE=mock
DOMAINNAMEAPI_RESELLER_ID=your-reseller-id
DOMAINNAMEAPI_TEST_API_KEY=your-test-environment-api-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@Hembox.io