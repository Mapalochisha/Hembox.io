# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Domain registrar — NameSilo. Modes: mock (default), namesilo-sandbox (OTE endpoint), namesilo (production endpoint).
# Live-mode registration (registerDomain) is gated behind DOMAIN_PROVIDER_MODE=namesilo + NAMESILO_API_KEY,
# verified pricing, confirmed availability, and settled payment. No TLD is enabled until costs are approved.
# Keep both credentials server-side; never use NEXT_PUBLIC_ variables for registrar keys.
DOMAIN_PROVIDER_MODE=mock
DOMAIN_PAYMENT_PROVIDER_MODE=disabled
# Manual payment instructions shown only to the signed-in customer who owns the order.
# Configure with the approved receiving-account instructions before enabling manual payment.
DOMAIN_MANUAL_PAYMENT_INSTRUCTIONS=
NAMESILO_API_KEY=your-namesilo-api-key
NAMESILO_SANDBOX_API_KEY=your-namesilo-sandbox-api-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@Hembox.io