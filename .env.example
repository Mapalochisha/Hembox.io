# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Domain registrar — NameSilo availability checks only; no registration/renewal/transfer/DNS actions enabled.
# Keep the API key server-side in .env.local / Vercel Environment Variables; never use NEXT_PUBLIC_.
DOMAIN_PROVIDER_MODE=mock
DOMAIN_PAYMENT_PROVIDER_MODE=disabled
NAMESILO_API_KEY=your-namesilo-api-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@Hembox.io